<?xml version="1.0" encoding="UTF-8"?>

<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="ShareableViewDefinition"/>
  <url value="http://hl7.org/fhir/uv/sql-on-fhir/StructureDefinition/ShareableViewDefinition"/>
  <name value="ShareableViewDefinition"/>
  <title value="Shareable View Definition"/>
  <status value="active"/>
  <description value="A profile for View Definitions intended to be shared between multiple systems. This requires &#xA;the publication metadata needed to identify, version and attribute a View Definition when it is &#xA;distributed: a URL, version, name, title, publisher and description. It also requires declaration &#xA;of the FHIR version that the view is intended to be executed over, and the FHIR type of each column. &#xA;This ensures consistent interpretation of the view across different view runner implementations. &#xA;The metadata requirements follow the CRMI Shareable Library profile."/>
  <fhirVersion value="5.0.0"/>
  <kind value="resource"/>
  <abstract value="false"/>
  <type value="ViewDefinition"/>
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/ViewDefinition|3.0.0-ballot"/>
  <derivation value="constraint"/>
  <differential>
    <element id="ViewDefinition">
      <path value="ViewDefinition"/>
    </element>
    <element id="ViewDefinition.url">
      <path value="ViewDefinition.url"/>
      <min value="1"/>
      <mustSupport value="true"/>
    </element>
    <element id="ViewDefinition.version">
      <path value="ViewDefinition.version"/>
      <min value="1"/>
      <mustSupport value="true"/>
    </element>
    <element id="ViewDefinition.versionAlgorithm[x]">
      <path value="ViewDefinition.versionAlgorithm[x]"/>
      <mustSupport value="true"/>
    </element>
    <element id="ViewDefinition.name">
      <path value="ViewDefinition.name"/>
      <min value="1"/>
      <mustSupport value="true"/>
    </element>
    <element id="ViewDefinition.title">
      <path value="ViewDefinition.title"/>
      <min value="1"/>
      <mustSupport value="true"/>
    </element>
    <element id="ViewDefinition.status">
      <path value="ViewDefinition.status"/>
      <mustSupport value="true"/>
    </element>
    <element id="ViewDefinition.experimental">
      <path value="ViewDefinition.experimental"/>
      <mustSupport value="true"/>
    </element>
    <element id="ViewDefinition.publisher">
      <path value="ViewDefinition.publisher"/>
      <min value="1"/>
      <mustSupport value="true"/>
    </element>
    <element id="ViewDefinition.description">
      <path value="ViewDefinition.description"/>
      <min value="1"/>
      <mustSupport value="true"/>
    </element>
    <element id="ViewDefinition.fhirVersion">
      <path value="ViewDefinition.fhirVersion"/>
      <min value="1"/>
    </element>
    <element id="ViewDefinition.select.column.type">
      <path value="ViewDefinition.select.column.type"/>
      <min value="1"/>
    </element>
  </differential>
</StructureDefinition>
